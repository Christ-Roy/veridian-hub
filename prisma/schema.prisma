// Prisma schema du Hub Veridian
// Cible : veridian-core-db (Postgres 16 dédié), schema `hub_app`
//
// Conventions :
// - Toutes les tables vivent dans le schema `hub_app` (pas de `public`)
// - Chaque teammate ajoute UNIQUEMENT ses modèles. Le schéma est partagé :
//   * hub-auth-builder (P1.4) : User, Account, Session, VerificationToken, MfaCode
//   * hub-members-builder (P1.5) : WorkspaceMember, Invitation
// - Les conflits de merge sur ce fichier sont arbitrés par le lead.

// La connection URL est déclarée dans ../prisma.config.ts (Prisma 7)
// via l'adapter Postgres. Ne PAS rajouter `url = env("DATABASE_URL")` ici.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["hub_app"]
}

// ============================================================================
// Auth.js v5 core models (P1.4 — hub-auth-builder)
// Conformes au schéma attendu par @auth/prisma-adapter.
// https://authjs.dev/getting-started/adapters/prisma
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  // 2FA email opt-in
  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  // Legacy bridge — quand un user Supabase existant se login via Auth.js,
  // on stocke ici son auth.users.id (uuid stringifié) pour corrélation.
  supabaseUserId String? @unique @map("supabase_user_id")

  // Stripe Customer ID (cus_xxx) — 1 user = 1 Stripe Customer. Permet au
  // webhook orchestrator (app/api/webhooks/route.ts) de résoudre rapidement
  // customer.id → user.id sans passer par le lookup en cascade
  // (subscriptions.stripe_customer_id → metadata → email). Populé au 1er
  // checkout via /api/billing/checkout, ou backfillé depuis Subscription.
  stripeCustomerId String? @unique @map("stripe_customer_id")

  accounts Account[]
  sessions Session[]
  mfaCodes MfaCode[]

  crossAppInvitationsSent     CrossAppInvitation[] @relation("CrossAppInvitationsSent")
  crossAppInvitationsAccepted CrossAppInvitation[] @relation("CrossAppInvitationsAccepted")

  mailEvents MailEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@schema("hub_app")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  // Mail Gateway v1 (ticket 2026-05-25-gmail-send-implementation-hub.md) —
  // flag levé par le broker quand un refresh_token retourne `invalid_grant`
  // côté Google/Microsoft (révocation user / mot de passe changé / consent
  // retiré). L'UI /dashboard/settings/mail le lit pour afficher un warning
  // rouge + bouton "Reconnecter mon Gmail". Reset à false après nouveau
  // consent réussi (callback OAuth Client 2).
  mailSendNeedsReauth Boolean @default(false) @map("mail_send_needs_reauth")

  // Mail Gateway v1 — liste des scopes effectivement obtenus pour cet
  // Account, sous forme CSV (ex : "openid email profile
  // https://www.googleapis.com/auth/gmail.send"). Le broker ne sélectionne
  // un Account pour l'envoi de mail que si ce champ contient `gmail.send`
  // (ou `Mail.Send` côté Microsoft v2). Distinct du champ `scope` Auth.js
  // qui est posé par le provider sign-in (basic) et ne reflète pas le
  // consent étendu Mail Sender.
  mailSendScope String? @map("mail_send_scope")

  // Mail Gateway v2 (ticket 2026-05-25-mail-provider-status-endpoint.md) —
  // marqueur "compte par défaut pour Mail Send". Un user peut avoir N
  // Accounts OAuth (Gmail perso + Microsoft pro + autre Gmail). Quand une
  // app downstream appelle `POST /api/mail/send-as-user` sans
  // `mail_account_id`, on résout via cette colonne (1 seul Account
  // par user peut être true grâce à l'index unique partiel). Si aucun
  // Account du user n'est marqué `true`, fallback ordre = premier Account
  // qui contient `gmail.send` dans `mailSendScope`.
  isDefaultForMail Boolean @default(false) @map("is_default_for_mail")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
  @@schema("hub_app")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("hub_app")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("hub_app")
}

// ============================================================================
// 2FA email opt-in (P1.4 — hub-auth-builder)
// ============================================================================
//
// Flow :
// 1. User active le toggle MFA dans /dashboard/settings/security
// 2. À chaque login (nouvelle session, cookie absent), on génère un code 6
//    chiffres, on le hash (bcrypt), on le stocke ici avec expiresAt = +10min
// 3. On envoie le code au mail user via Brevo / SMTP Lark
// 4. User tape le code sur /auth/mfa, on vérifie (constant-time), on marque
//    consumedAt et on autorise la création de la session Auth.js
// 5. Les codes expirés ou consommés sont purgés via un cron (P2+)

model MfaCode {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("mfa_codes")
  @@schema("hub_app")
}

// ============================================================================
// Workspace membres + invitations (P1.5 — hub-members-builder)
// ============================================================================
//
// Flow invitation :
// 1. OWNER ou ADMIN POST /api/workspace/invite (email + role)
// 2. Création Invitation (token random, expiresAt +7j), email Brevo envoyé
// 3. Destinataire clique /invite/[token] → login si besoin → acceptation
// 4. Création WorkspaceMember + Invitation.acceptedAt renseigné
//
// Un seul workspace par tenant au lancement. Multi-workspace en P3+.

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@schema("hub_app")
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members     WorkspaceMember[]
  invitations Invitation[]

  @@map("workspaces")
  @@schema("hub_app")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  invitedAt   DateTime      @default(now()) @map("invited_at")
  joinedAt    DateTime?     @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId])
  @@map("workspace_members")
  @@schema("hub_app")
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole
  token       String        @unique
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([email, workspaceId])
  @@map("invitations")
  @@schema("hub_app")
}

// ============================================================================
// Invitations cross-app (P1 invitation endpoints — créé 2026-05-20)
//
// Flow :
//   1. App downstream (Notifuse, Prospection, ...) appelle Hub
//      POST /api/invitations/create avec HMAC. Body inclut target_app +
//      target_workspace_id externe à l'app (pas une FK Hub).
//   2. Hub crée une row, génère token, envoie magic link via Notifuse.
//   3. Destinataire clique /invite/[token] sur le Hub, se logge (n'importe
//      quel provider), accepte → Hub appelle l'app downstream pour attacher
//      l'user au workspace cible (HMAC contract HUB→app).
//   4. acceptedAt + acceptedByUserId renseignés, l'app downstream renvoie
//      l'URL d'auto-login.
//
// Distinct du modèle `Invitation` ci-dessus qui couvre les invitations
// internes au workspace Hub (multi-membre billing Hub). Ici on parle
// d'invitations EXTERNES qui rattachent un Hub user à un workspace
// downstream — `target_workspace_id` n'est pas une FK Prisma car la table
// vit dans une autre DB (DB Notifuse, DB Prospection, etc.).
// ============================================================================

model CrossAppInvitation {
  id                String    @id @default(cuid())
  token             String    @unique // 32 bytes hex, URL-safe
  inviterUserId     String    @map("inviter_user_id")
  inviterEmail      String    @map("inviter_email")
  inviteeEmail      String    @map("invitee_email")
  targetApp         String    @map("target_app") // 'notifuse' | 'prospection' | 'analytics' | 'cms'
  targetWorkspaceId String    @map("target_workspace_id")
  targetRole        String    @default("member") @map("target_role")
  message           String?
  expiresAt         DateTime  @map("expires_at")
  acceptedAt        DateTime? @map("accepted_at")
  acceptedByUserId  String?   @map("accepted_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  inviter    User  @relation("CrossAppInvitationsSent", fields: [inviterUserId], references: [id])
  acceptedBy User? @relation("CrossAppInvitationsAccepted", fields: [acceptedByUserId], references: [id])

  @@index([inviteeEmail])
  @@index([targetApp, targetWorkspaceId])
  @@index([expiresAt])
  @@map("cross_app_invitations")
  @@schema("hub_app")
}

// ============================================================================
// Migration Supabase → Prisma (2026-05-08)
// Tables legacy déplacées depuis Supabase public.* vers hub_app.*
// IDs UUID préservés depuis l'ancienne source pour ne pas casser les FK et
// les références externes (Stripe customerId, etc.).
// ============================================================================

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
  incomplete_expired
  unpaid

  @@schema("hub_app")
}

enum TenantStatus {
  pending
  active
  suspended
  deleted

  @@schema("hub_app")
}

enum LogLevel {
  info
  success
  warning
  error

  @@schema("hub_app")
}

enum PricingType {
  one_time
  recurring

  @@schema("hub_app")
}

enum PricingPlanInterval {
  day
  week
  month
  year

  @@schema("hub_app")
}

model Profile {
  id             String   @id @db.Uuid
  email          String   @unique
  fullName       String?  @map("full_name")
  avatarUrl      String?  @map("avatar_url")
  companyName    String?  @map("company_name")
  billingAddress Json?    @map("billing_address")
  paymentMethod  Json?    @map("payment_method")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
  @@schema("hub_app")
}

model Product {
  id          String   @id
  active      Boolean?
  name        String?
  description String?
  image       String?
  metadata    Json?

  prices Price[]

  @@map("products")
  @@schema("hub_app")
}

model Price {
  id              String               @id
  productId       String?              @map("product_id")
  active          Boolean?
  description     String?
  unitAmount      BigInt?              @map("unit_amount")
  currency        String?
  type            PricingType?
  interval        PricingPlanInterval?
  intervalCount   Int?                 @map("interval_count")
  trialPeriodDays Int?                 @map("trial_period_days")
  metadata        Json?

  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("prices")
  @@schema("hub_app")
}

// ============================================================================
// Stripe events — audit log + idempotence webhook (ticket 2026-05-21 orchestrator)
// ============================================================================
//
// Le Hub est l'orchestrateur Stripe central (cf docs/CONTRAT-HUB.md §7.4).
// Chaque webhook reçu est persisté ici AVANT dispatch :
//   - PK sur event_id (evt_xxx) → idempotence (Stripe retry jusqu'à 200 reçu)
//   - processed_at NULL = en attente ou en cours
//   - processed_at NOT NULL = dispatch OK
//   - error NOT NULL = dispatch a échoué, attempts > 0 = retry possible
//
// Source de vérité audit + base du dashboard MRR cross-app.

model StripeEvent {
  eventId     String    @id @map("event_id")
  eventType   String    @map("event_type")
  customerId  String?   @map("customer_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?
  attempts    Int       @default(0)

  @@index([eventType])
  @@index([customerId])
  @@map("stripe_events")
  @@schema("hub_app")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  stripeCustomerId     String             @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  priceId              String?            @map("price_id")
  status               SubscriptionStatus @default(incomplete)
  trialStart           DateTime?          @map("trial_start") @db.Timestamptz(6)
  trialEnd             DateTime?          @map("trial_end") @db.Timestamptz(6)
  currentPeriodStart   DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean?           @default(false) @map("cancel_at_period_end")
  cancelAt             DateTime?          @map("cancel_at") @db.Timestamptz(6)
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz(6)
  endedAt              DateTime?          @map("ended_at") @db.Timestamptz(6)
  created              DateTime?          @db.Timestamptz(6)
  planName             String?            @map("plan_name")
  quantity             Int?               @default(1)
  metadata             Json?
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  price   Price?   @relation(fields: [priceId], references: [id])
  tenants Tenant[]

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
  @@schema("hub_app")
}

model Tenant {
  id                             String       @id @default(uuid()) @db.Uuid
  userId                         String       @map("user_id") @db.Uuid
  subscriptionId                 String?      @map("subscription_id") @db.Uuid
  name                           String
  slug                           String       @unique
  status                         TenantStatus @default(pending)
  notifuseWorkspaceSlug          String?      @map("notifuse_workspace_slug")
  notifuseApiKey                 String?      @map("notifuse_api_key")
  notifuseUserEmail              String?      @map("notifuse_user_email")
  notifuseInvitationSentAt       DateTime?    @map("notifuse_invitation_sent_at") @db.Timestamptz(6)
  notifusePlan                   String?      @default("free") @map("notifuse_plan")
  prospectionApiKey              String?      @map("prospection_api_key")
  prospectionLoginToken          String?      @map("prospection_login_token")
  prospectionLoginTokenUsed      Boolean?     @default(false) @map("prospection_login_token_used")
  prospectionLoginTokenCreatedAt DateTime?    @map("prospection_login_token_created_at") @db.Timestamptz(6)
  prospectionPlan                String?      @default("freemium") @map("prospection_plan")
  prospectionConfig              Json?        @map("prospection_config")
  prospectionProvisionedAt       DateTime?    @map("prospection_provisioned_at") @db.Timestamptz(6)
  metadata                       Json?
  provisionedAt                  DateTime?    @map("provisioned_at") @db.Timestamptz(6)
  lastActivityAt                 DateTime?    @map("last_activity_at") @db.Timestamptz(6)
  leadScore                      Int?         @default(0) @map("lead_score")
  trialEndsAt                    DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  deletedAt                      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  cleanupNotifiedAt              DateTime?    @map("cleanup_notified_at") @db.Timestamptz(6)
  createdAt                      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id])
  provisioningLogs ProvisioningLog[]
  usageMetrics     UsageMetric[]

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@index([notifusePlan], map: "tenants_notifuse_plan_idx")
  @@map("tenants")
  @@schema("hub_app")
}

/// Activation d'une app gated par tenant (panneau d'admin SaaS).
///
/// Pilote l'affichage "actif" des cards dashboard pour les services PAS
/// grand public (twenty/CRM, analytics, cms). Par défaut une app n'a PAS de
/// row → considérée DÉSACTIVÉE. C'est Robert (gestionnaire SaaS) qui active
/// une app pour un tenant via l'Admin API.
///
/// HORS périmètre : prospection + notifuse restent TOUJOURS grand public
/// (jamais gérés ici, toujours visibles sur le dashboard).
///
/// `userId` = UUID bridge (Tenant.userId / supabaseUserId), cohérent avec
/// les autres tables tenants/subscriptions qui pivotent sur cet UUID.
model TenantApp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  appKey    String    @map("app_key") // 'twenty' | 'analytics' | 'cms'
  enabled   Boolean   @default(false)
  enabledAt DateTime? @map("enabled_at") @db.Timestamptz(6)
  enabledBy String?   @map("enabled_by") // email admin ayant activé (audit)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, appKey])
  @@index([userId])
  @@map("tenant_apps")
  @@schema("hub_app")
}

model ProvisioningLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  level     LogLevel
  message   String
  service   String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([level])
  @@map("provisioning_logs")
  @@schema("hub_app")
}

model UsageMetric {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  metricType String   @map("metric_type")
  value      BigInt
  timestamp  DateTime @db.Timestamptz(6)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, metricType, timestamp(sort: Desc)])
  @@map("usage_metrics")
  @@schema("hub_app")
}

// ============================================================================
// Webhook dédup + memberships cross-app (v1.4 contrat — créé 2026-05-21)
// ============================================================================
//
// WebhookDedup : table de déduplication des webhooks app → Hub. PK composite
// (app, idempotency_key) — chaque app maintient son propre espace d'idempotency
// keys. Fenêtre de dédup 24h, purge via cron (P2+). Stocke payload pour audit.
//
// TenantMember : memberships cross-app §11bis du contrat. Hub source de vérité.
// `last_known_app_role` peut diverger temporairement de `role` (sync best-effort
// via webhook `tenant.member_role_changed`).

model WebhookDedup {
  idempotencyKey String    @map("idempotency_key")
  app            String
  eventType      String    @map("event_type")
  payload        Json
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")

  @@id([app, idempotencyKey])
  @@index([receivedAt])
  @@map("webhook_dedup")
  @@schema("hub_app")
}

model TenantMember {
  tenantId         String    @map("tenant_id")
  userId           String    @map("user_id")
  role             String    @default("member")
  joinedAt         DateTime  @default(now()) @map("joined_at")
  deletedAt        DateTime? @map("deleted_at")
  lastKnownAppRole String?   @map("last_known_app_role")

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
  @@schema("hub_app")
}

// ============================================================================
// Trial state machine cross-app (créé 2026-05-21)
// ============================================================================
//
// Source de vérité de l'état "trial" pour chaque (tenant, app). La state
// machine est pilotée :
//   - en entrée par les webhooks `tenant.activity_threshold_reached` que les
//     apps émettent quand un seuil d'engagement métier est atteint
//     (Notifuse = 5 emails envoyés lifetime), qui crée une row state=eligible
//   - en avancée par le cron `/api/cron/trial-tick` (toutes les 30 min) qui :
//       * eligible → trial_active après 48h (appel update-plan plan=pro)
//       * trial_active → notif "expire dans 3j" à J+12
//       * trial_active → expired à J+15 sans Stripe sub active
//         (appel update-plan plan=free)
//       * trial_active → converted à J+15 si Stripe sub active prend le relais
//
// Voir `docs/PRICING-VERIDIAN.md` §"Flow trial complet" pour la vision
// business et `docs/CONTRAT-HUB.md` §"Trial state machine" pour le contrat
// technique.
//
// Convention :
//   - PK composite (tenant_id, app) — 1 trial par (tenant, app) lifetime.
//     Un user peut avoir 1 trial Notifuse + 1 trial Prospection en même
//     temps. Pas de re-trial (décision figée 2026-05-21).
//   - Index partiel sur trial_ends_at WHERE state='trial_active' — le cron
//     ne scanne que les rows actives, pas toute la table.

enum TrialState {
  eligible
  trial_active
  trial_ending_soon
  expired
  converted

  @@schema("hub_app")
}

model TenantTrial {
  tenantId             String     @map("tenant_id")
  app                  String
  state                TrialState
  eligibleAt           DateTime?  @map("eligible_at") @db.Timestamptz(6)
  trialStartedAt       DateTime?  @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt          DateTime?  @map("trial_ends_at") @db.Timestamptz(6)
  endingSoonNotified   Boolean    @default(false) @map("ending_soon_notified")
  expiredAt            DateTime?  @map("expired_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, app])
  @@index([state])
  @@map("tenant_trials")
  @@schema("hub_app")
}

// ============================================================================
// AUDIT LOG — traces des actions admin (API admin, scripts, agents IA)
// ============================================================================
// Append-only. Aucune route ne fait UPDATE ni DELETE sur cette table.
// Cible : forensics + reproductibilité des actions de provisioning manuel.

model AuditLog {
  id         String   @id @default(cuid())
  action     String // ex: 'admin.user.create', 'admin.tenant.link', 'admin.tenant.unlink'
  actor      String // ex: 'admin:robert.brunon@veridian.site', 'token:HUB_ADMIN_TOKEN'
  targetType String?  @map("target_type") // 'user' | 'tenant' | 'app_link'
  targetId   String?  @map("target_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, createdAt])
  @@index([targetId])
  @@index([actor, createdAt(sort: Desc)], map: "audit_log_actor_created_at_idx")
  @@map("audit_log")
  @@schema("hub_app")
}

// ============================================================================
// VERIDIAN CRM — tenants Twenty fork (créé 2026-05-27)
// ============================================================================
//
// Table dédiée pour les workspaces Twenty (fork AGPL crm.staging.veridian.site)
// provisionnés via POST /api/admin/crm/create-tenant.
//
// SÉPARÉE de `tenants` (scope Notifuse + Prospection) :
//   - Le CRM Twenty a son propre cycle de vie (workspace fork avec storage
//     custom, pas de plan billing Hub-side pour l'instant)
//   - Les colonnes Bearer/password sont chiffrées AES-256-GCM avec
//     CRM_VAULT_KEY (cf `lib/crm/vault.ts`)
//   - L'idempotence est par email (UNIQUE partiel WHERE status != 'deleted')
//
// `userId` référence `users.supabase_user_id` (UUID v4 bridge), même pattern
// que Tenant.userId. Pas de FK physique car la colonne cible est nullable.

model CrmTenant {
  id                        String    @id @default(uuid()) @db.Uuid
  // FK logique vers hub_app.users.id (cuid text, pas uuid). Pas de relation
  // Prisma typée pour rester aligné avec le pattern Tenant existant + éviter
  // les contraintes au moment où le user est en cours de création.
  userId                    String    @map("user_id")
  email                     String
  workspaceDisplayName      String    @map("workspace_display_name")
  twentyWorkspaceId         String    @unique @map("twenty_workspace_id") @db.Uuid
  twentyWorkspaceUrl        String    @map("twenty_workspace_url")
  twentyApiKeyId            String    @map("twenty_api_key_id") @db.Uuid
  twentyApiKeyEncrypted     String    @map("twenty_api_key_encrypted")
  twentyApiKeyExpiresAt     DateTime  @map("twenty_api_key_expires_at") @db.Timestamptz(6)
  twentyPasswordEncrypted   String    @map("twenty_password_encrypted")
  status                    String    @default("active") // active | suspended | deleted
  metadata                  Json?
  provisionedAt             DateTime? @map("provisioned_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("crm_tenants")
  @@schema("hub_app")
}

// ============================================================================
// OAUTH SIGN-IN EVENTS — audit log des connexions OAuth (succès + échecs)
// ============================================================================
// Append-only. Aucune route ne fait UPDATE ni DELETE sur cette table.
// Cible : observabilité OAuth (timeline admin), détection de pics d'échecs
// (brute-force, provider en panne), forensics "qui s'est connecté quand".
//
// Câblé sur les deux issues d'un flow OAuth :
//   - succès : event `signIn` Auth.js v5 (provider + email + isNewUser connus)
//   - échec  : logger.error Auth.js (OAuthCallbackError / Configuration)
//
// `event` reste un String libre (pas un enum) : on n'attend que
// 'success' | 'failure' aujourd'hui, mais garder un String évite une
// migration d'enum si on ajoute un état intermédiaire plus tard.
// Phase 2-3 du ticket todo/2026-05-20-oauth-rate-limiting-monitoring.md.

// ============================================================================
// MAIL EVENTS — audit log Mail Gateway v1 (Gmail, puis Microsoft v2)
// ============================================================================
// Append-only. Aucune route ne fait UPDATE ni DELETE sur cette table.
// Source de vérité "qui a envoyé quoi via quelle app via quel provider".
//
// Câblé par :
//   - `lib/mail/send-gmail.ts` : insère une row à chaque envoi (status='sent',
//     'failed' ou 'needs_reauth')
//   - `POST /api/mail/send-as-user` : vérifie idempotency_key avant d'appeler
//     le broker pour permettre le replay safe (retours 200 idempotent).
//
// PII : `recipient` et `subject` peuvent contenir des données personnelles.
// FK cascade sur users garantit RGPD basic (suppression user → mails purgés).
// Rétention longue acceptable pour audit, mais purge ≥6 mois possible via
// cron (P3+).

model MailEvent {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  // App qui a appelé /api/mail/send-as-user (whitelist enforced côté HMAC) :
  // 'notifuse' | 'prospection' | 'cms' | 'analytics' | 'hub-test'
  // hub-test : utilisé par la route interne /api/gmail/test-send (UI settings)
  appSource         String   @map("app_source")
  // Provider du compte d'envoi : 'google' (v1) | 'microsoft' (v2)
  provider          String
  // Premier destinataire de la liste `to` (pour audit indexable — la liste
  // complète vit dans la MIME envoyée, pas la peine de la dupliquer ici).
  recipient         String
  subject           String
  providerMessageId String?  @map("provider_message_id")
  // 'sent' | 'failed' | 'needs_reauth'
  status            String
  errorMessage      String?  @map("error_message")
  // UUID v4 unique fourni par l'app appelante (anti double-envoi sur retry).
  idempotencyKey    String   @unique @map("idempotency_key")
  sentAt            DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt(sort: Desc)])
  @@index([appSource, sentAt(sort: Desc)])
  @@map("mail_events")
  @@schema("hub_app")
}

// ============================================================================
// Mail Gateway v2 — rate-limit per-recipient (ticket
// 2026-05-25-mail-provider-status-endpoint.md)
// ============================================================================
//
// Robert 2026-05-25 : "1 mail toutes les 20 minutes comme limite par email".
// Protection anti-spam Lemlist-like — applique GLOBAL Hub-side (cross-app,
// cross-user, cross-account). Si quelqu'un — n'importe quel user, via
// n'importe quelle app — a déjà envoyé un mail à `spam@example.com` il y
// a moins de 20 minutes, le prochain envoi à cette adresse est bloqué.
//
// Cible : `to[]` uniquement. cc/bcc NE sont PAS rate-limités (cc = copie
// informative, bcc = invisible — pas de spam direct sur eux).

model MailRecipientRateLimit {
  // PK = email destinataire (lowercase normalisé côté code avant lookup).
  recipientEmail String   @id @map("recipient_email")
  // Horodatage du dernier envoi réussi. Si < NOW - 20min → on bloque.
  lastSentAt     DateTime @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  // Audit léger pour forensics : qui a envoyé le dernier mail à ce
  // destinataire (un user_id Hub) ET via quelle app (notifuse / prospection
  // / cms / analytics / hub-test).
  senderUserId   String   @map("sender_user_id")
  appCaller      String   @map("app_caller")

  @@index([lastSentAt(sort: Desc)])
  @@map("mail_recipient_rate_limit")
  @@schema("hub_app")
}

// ============================================================================
// Mail Gateway v2 — audit forensics rate-limit (append-only)
// ============================================================================
//
// 1 row par destinataire bloqué (chaque déclenchement 207 multi-status
// ou 429 rate_limit_recipient). Consommé par
// `GET /api/admin/mail-rate-limit/stats` pour le dashboard Robert.

model MailRateLimitEvent {
  id                 String   @id @default(cuid())
  timestamp          DateTime @default(now()) @db.Timestamptz(6)
  recipientEmail     String   @map("recipient_email")
  senderUserId       String   @map("sender_user_id")
  appCaller          String   @map("app_caller")
  retryAfterSeconds  Int      @map("retry_after_seconds")

  @@index([timestamp(sort: Desc)])
  @@index([recipientEmail, timestamp(sort: Desc)])
  @@index([senderUserId, timestamp(sort: Desc)])
  @@map("mail_rate_limit_events")
  @@schema("hub_app")
}

model OauthSigninEvent {
  id         String   @id @default(cuid())
  event      String // 'success' | 'failure'
  provider   String // 'google' | 'microsoft-entra-id' | 'mock-oauth' | 'unknown'
  email      String? // null si l'échec survient avant résolution de l'email
  ip         String?
  userAgent  String?  @map("user_agent")
  errorCode  String?  @map("error_code") // ex: 'OAuthCallbackError', 'Configuration'
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "oauth_signin_events_created_at_idx")
  @@index([email])
  @@map("oauth_signin_events")
  @@schema("hub_app")
}

// ============================================================================
// Réconciliateur events COMPORTEMENTAUX cold↔web (2026-06-15)
// Ticket : todo/2026-06-15-reconciliateur-events-cold-web-prospect-scoring.md
// Spec   : notifuse-veridian/todo/2026-06-15-SPEC-reconciliation-cold-web-events-hub.md
// ============================================================================
//
// DISTINCT de la réconciliation BILLING (lib/sync/reconcile.ts = état tenant).
// Ici on ingère les events COMPORTEMENTAUX émis par les apps (Notifuse :
// email.opened/clicked/replied ; Analytics plus tard : page.hit) pour SCORER
// le prospect et prioriser les chauds dans le CRM Twenty.
//
// V1 (ce lot) : jointure par `contactEmail` (le prospect = une adresse mail).
// Le `vid` (ID prospect déterministe propagé cross-app) est nullable au V1 ;
// l'étage 2 (vid prioritaire, contactEmail fallback) viendra après que
// Notifuse propage le vid dans les liens /t/ /r/ et qu'Analytics le capte.
//
// Le STANDARD d'event comportemental que TOUTE app émet est gravé dans
// docs/CONTRAT-HUB.md §7.5.

/// Event comportemental ingéré (1 row par event après dédup).
///
/// Clé d'idempotence applicative : `idempotencyKey` (UNIQUE). La dédup de
/// transport (webhook_dedup PK (app, idempotency_key)) protège la route ;
/// cet UNIQUE protège l'insertion ProspectEvent elle-même (best-effort :
/// un INSERT en doublon = no-op, le score n'est PAS ré-incrémenté).
///
/// `tenantId` = clé fournie par le mapping côté webhook. Pour Notifuse on
/// reçoit le `notifuse_workspace_slug` → on stocke le slug ET, quand le
/// mapping Tenant résout, l'UUID tenant Hub dans `tenantUuid` (nullable :
/// un event d'un workspace orphelin reste ingéré pour forensics).
model ProspectEvent {
  id             String   @id @default(uuid()) @db.Uuid
  // App émettrice : 'notifuse' | 'analytics' (extensible).
  app            String
  // Type d'event canonique : 'email.opened' | 'email.clicked' |
  // 'email.replied' | 'page.hit' (extensible — cf barème lib/prospect/scoring.ts).
  eventType      String   @map("event_type")
  // ID prospect déterministe cross-app. NULLABLE au V1 (jointure par email).
  vid            String?
  // Clé tenant telle que fournie par l'app (Notifuse = workspace slug).
  workspaceSlug  String   @map("workspace_slug")
  // UUID tenant Hub résolu via le mapping (nullable si workspace orphelin).
  tenantUuid     String?  @map("tenant_uuid") @db.Uuid
  // Adresse mail du prospect (clé de jointure V1). NULLABLE (page.hit anonyme).
  contactEmail   String?  @map("contact_email")
  // Idempotence applicative — UUID v4 fourni par l'émetteur.
  idempotencyKey String   @unique @map("idempotency_key")
  // Quand l'event s'est produit côté app (ISO8601 → DateTime).
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  // Payload brut spécifique à l'event (message_id, link_url, page_path, ...).
  data           Json
  // Quand le Hub a reçu/ingéré l'event.
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([vid, occurredAt(sort: Desc)])
  @@index([workspaceSlug, eventType])
  @@index([contactEmail])
  @@index([tenantUuid])
  @@map("prospect_events")
  @@schema("hub_app")
}

/// Score d'engagement agrégé PAR PROSPECT (pas par tenant → table dédiée,
/// distincte de Tenant.leadScore qui est un signal billing par tenant).
///
/// Clé V1 = (workspaceSlug, contactEmail). Le `vid` est dénormalisé ici pour
/// la migration future vers une clé (workspaceSlug, vid) sans perte de data.
///
/// SCORING DÉCOUPLÉ (2026-06-17) : ces colonnes sont écrites par la couche
/// scoring SÉPARÉE (un `ScoringEngine` recompute FROM-SCRATCH depuis les events
/// agrégés, appelé À LA DEMANDE par le job/cron de push — PAS à l'ingestion des
/// events). `engagementScore` n'est donc PAS une somme additive mais le résultat
/// du moteur (barème tunnel par défaut — caps, non-cumul, récence, disqualif).
///   - `label`        : froid / tiede / chaud (dérivé du score, seuil chaud 30).
///   - `disqualified` : bounce dur OU unsubscribe → score 0 + doNotContact CRM.
///   - `components`   : détail des points par composant ({email_clicks: 30,
///     identify_email: 35, ...}) — le score n'est pas une boîte noire, poussé
///     tel quel dans le CRM.
///   - `signals`      : compteurs résumés par signal ({opened, clicked, ...})
///     pour la timeline, dérivés des mêmes components (jamais de dérive).
model ProspectScore {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceSlug   String    @map("workspace_slug")
  contactEmail    String    @map("contact_email")
  vid             String?
  tenantUuid      String?   @map("tenant_uuid") @db.Uuid
  engagementScore Int       @default(0) @map("engagement_score")
  /// Label dérivé du score : 'froid' | 'tiede' | 'chaud'.
  label           String    @default("froid")
  /// Bounce dur ou opt-out → score forcé à 0, doNotContact côté CRM.
  disqualified    Boolean   @default(false)
  lastEventAt     DateTime? @map("last_event_at") @db.Timestamptz(6)
  signals         Json      @default("{}")
  /// Détail des points par composant (score explicable, poussé au CRM).
  components      Json      @default("{}")
  /// IDEMPOTENCE SORTANTE (push CRM découplé, 2026-06-17). Le cron
  /// `push-prospect-scores` ne re-pousse au CRM que si le score a CHANGÉ depuis
  /// le dernier push — sinon il spammerait Twenty à chaque tick. Ces deux
  /// colonnes mémorisent l'état du DERNIER push réussi :
  ///   - `crmPushedScore` : la valeur d'`engagementScore` au moment du push.
  ///     Le cron compare `crmPushedScore !== engagementScore` avant de pousser.
  ///     NULL = jamais poussé (→ premier push inconditionnel si score scorable).
  ///   - `crmPushedAt`    : horodatage du dernier push réussi (observabilité +
  ///     débogage "ce prospect a-t-il bien été poussé ?").
  /// En DRY_RUN le cron NE met PAS à jour ces colonnes (rien n'a été réellement
  /// poussé) → l'idempotence sortante ne « consomme » que les vrais pushes.
  crmPushedAt     DateTime? @map("crm_pushed_at") @db.Timestamptz(6)
  crmPushedScore  Int?      @map("crm_pushed_score")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceSlug, contactEmail], map: "prospect_scores_workspace_email_unique")
  @@index([workspaceSlug, engagementScore(sort: Desc)])
  @@index([vid])
  @@map("prospect_scores")
  @@schema("hub_app")
}
