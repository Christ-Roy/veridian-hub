# ============================================================================
# Veridian Hub — Variables d'environnement
# ============================================================================
#
# Convention :
#   [REQUIRED]   — l'app crash sans, à poser sur tout environnement
#   [OPTIONAL]   — feature dégradée si absente (fallback silencieux)
#   [BUILD-TIME] — injectée à la build Docker, lue runtime
#   [DEV-ONLY]   — utilisée seulement en local/dev, jamais en prod
#   [COMPOSE]    — consommée par docker compose pour fabriquer une autre var
#                  (DATABASE_URL, labels Traefik, image tag) — pas via process.env
#   [LEGACY]     — fenêtre de migration, à retirer après date prévue
#
# Source de vérité runtime prod : Dokploy ENV (interface UI) — voir
# veridian-infra/todo/ pour le ticket backup secrets.
#
# Garde-fou CI : `scripts/ci/check-env-sync.sh` refuse le push si une
# `process.env.X` est utilisée dans le code MAIS absente à la fois de ce
# fichier ET des composes. Skip via SKIP_ENV_SYNC=1 (à éviter).
#
# Copy to .env.local et remplis les valeurs réelles pour le dev local.
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# § 1. Database (Prisma → veridian-core-db schema hub_app)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL via Prisma.
# Format prod : postgresql://veridian:<password>@veridian-core-db:5432/veridian?schema=hub_app
DATABASE_URL=postgresql://veridian:password@veridian-core-db:5432/veridian?schema=hub_app

# [COMPOSE-PROD] Password du user `veridian` du Postgres prod, utilisé par
# compose/prod.yml pour fabriquer DATABASE_URL. Pas lu par le code.
VERIDIAN_CORE_DB_PASSWORD=

# [COMPOSE-STAGING] Password du user `hub` du Postgres staging (DB locale
# à la stack), utilisé par compose/staging.yml pour fabriquer DATABASE_URL.
# Fallback dans compose : `staging-pwd`. Pas lu par le code.
POSTGRES_PASSWORD=


# ──────────────────────────────────────────────────────────────────────────────
# § 2. Auth.js v5 (Credentials + OAuth Google/Microsoft + MFA email)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Secret JWT Auth.js. openssl rand -base64 32
# En compose/prod.yml, c'est ${HUB_AUTH_SECRET} (alias) qui est injecté
# dans la variable runtime AUTH_SECRET.
AUTH_SECRET=generate-with-openssl-rand-base64-32

# [COMPOSE] Alias compose pour AUTH_SECRET (clarté : on évite de manipuler
# AUTH_SECRET=... à la racine du host, où il pourrait fuiter dans d'autres
# services). Mappé vers AUTH_SECRET côté container.
HUB_AUTH_SECRET=

# [REQUIRED] URL absolue de l'app (cookie domain, callback OAuth)
AUTH_URL=https://app.veridian.site

# [REQUIRED] Permet à Auth.js v5 d'accepter le host derrière le reverse proxy.
AUTH_TRUST_HOST=true

# [LEGACY] Alias historique d'AUTH_URL (lu par certains helpers Stripe/redirect)
NEXTAUTH_URL=https://app.veridian.site

# [DEV-ONLY] Si "true", active le mode debug Auth.js (logs verbeux signin).
# Lu par auth.ts. Ne JAMAIS poser à true en prod.
AUTH_DEBUG=false

# [OPTIONAL] OAuth Google (signup/login). Si absent, bouton non affiché.
# Credentials : console.cloud.google.com, projet veridian-preprod.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# [OPTIONAL] OAuth Microsoft (signup/login). Si absent, bouton non affiché.
# Credentials : portal.azure.com, app "Veridian Hub Sign-in" (multi-tenant).
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# [STAGING-ONLY] Active le mock OAuth provider pour les tests E2E staging.
# Le code refuse de booter en prod (triple garde-fou dans
# lib/auth/mock-oauth-provider.ts). NE JAMAIS poser ailleurs qu'en staging.
OAUTH_TEST_PROVIDER=false


# ──────────────────────────────────────────────────────────────────────────────
# § 3. Admin & Cron (header-based auth)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Emails autorisés à accéder à /dashboard/admin/*, séparés par
# virgule. Match exact côté lib/admin/.
ADMIN_EMAILS=brunon5robert@gmail.com,robert.brunon@veridian.site

# [OPTIONAL] Secret pour appeler /api/admin/* via header x-admin-secret
# (scripts CI sans session Auth.js). Vide → header désactivé.
# openssl rand -hex 32
ADMIN_SECRET=

# [REQUIRED EN PROD] Secret d'auth pour les endpoints /api/cron/*. Le cron
# OVH envoie ce secret dans le header Authorization: Bearer <secret>.
# Sans ce secret, les crons retournent 401 = aucun followup déclenché.
# openssl rand -hex 32
CRON_SECRET=your-cron-secret-hex-32


# ──────────────────────────────────────────────────────────────────────────────
# § 4. Stripe billing (LIVE en prod, TEST en staging)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Clé secrète Stripe (lue par le code via STRIPE_SECRET_KEY).
# Prod : sk_live_... / Staging : sk_test_...
STRIPE_SECRET_KEY=sk_test_...

# [REQUIRED] Clé publique Stripe (exposée au frontend via /api/config).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# [REQUIRED] Secret webhook Stripe (events checkout.session.completed,
# invoice.paid, customer.subscription.*).
STRIPE_WEBHOOK_SECRET=whsec_...

# [COMPOSE-PROD] Variantes LIVE explicites (compose/prod.yml mappe celles-ci
# vers les variables canoniques sans suffixe ci-dessus, et expose aussi
# STRIPE_SECRET_KEY_LIVE pour les scripts qui veulent forcer LIVE).
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# [COMPOSE-STAGING] Variantes TEST. Fallback compose : pk_test_fake /
# sk_test_fake / whsec_fake (l'app boote mais Stripe ne valide rien).
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=


# ──────────────────────────────────────────────────────────────────────────────
# § 5. Notifuse (emails transactionnels + magic links tenants)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] URL publique Notifuse (frontend).
NEXT_PUBLIC_NOTIFUSE_URL=https://notifuse.app.veridian.site

# [REQUIRED] Endpoint API public Notifuse.
NEXT_PUBLIC_NOTIFUSE_API_URL=https://notifuse.app.veridian.site/api/v1

# [REQUIRED] URL serveur-to-serveur Hub → Notifuse (HMAC tenants endpoints).
NOTIFUSE_API_URL=https://notifuse.app.veridian.site

# [REQUIRED] Clé API Notifuse globale (legacy, signup root, healthcheck).
NOTIFUSE_SECRET_KEY=your-notifuse-secret

# [REQUIRED] Email root Notifuse (compte admin Notifuse, créé au boot).
NOTIFUSE_ROOT_EMAIL=admin@veridian.site

# [REQUIRED] HMAC secret partagé Hub → Notifuse pour /api/tenants/*.
# Doit matcher HUB_API_SECRET côté fork Notifuse.
NOTIFUSE_HUB_API_SECRET=your-hub-notifuse-shared-secret

# [REQUIRED] HMAC secret pour valider les webhooks legacy entrants Notifuse
# (events tenant.suspended, email.sent — header x-veridian-notifuse-signature).
NOTIFUSE_HUB_WEBHOOK_SECRET=your-hub-notifuse-webhook-secret

# [REQUIRED] Bearer token v1.4 — Notifuse POST /api/webhooks/notifuse
# (events tenant.touched, activity_threshold). openssl rand -hex 32
NOTIFUSE_WEBHOOK_TOKEN=

# [COMPOSE-STAGING] Variantes _STAGING utilisées par compose/staging.yml
# pour pointer vers une stack Notifuse staging dédiée.
NOTIFUSE_SECRET_KEY_STAGING=
NOTIFUSE_HUB_API_SECRET_STAGING=
NOTIFUSE_HUB_WEBHOOK_SECRET_STAGING=


# ──────────────────────────────────────────────────────────────────────────────
# § 6. Prospection (provisioning + webhooks)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] URL publique Prospection.
NEXT_PUBLIC_PROSPECTION_URL=https://prospection.app.veridian.site

# [REQUIRED] URL serveur-to-serveur Hub → Prospection.
PROSPECTION_API_URL=https://prospection.app.veridian.site

# [REQUIRED] HMAC secret partagé Hub → Prospection (provision, regen login).
PROSPECTION_TENANT_API_SECRET=your-tenant-secret

# [REQUIRED] HMAC secret partagé Hub ↔ Prospection (contrat v1.4 standard).
# Identique à HUB_API_SECRET côté Prospection.
PROSPECTION_HUB_API_SECRET=

# [REQUIRED] Bearer token v1.4 — Prospection POST /api/webhooks/prospection.
PROSPECTION_WEBHOOK_TOKEN=

# [COMPOSE-STAGING] Variante _STAGING pour la stack Prospection staging.
PROSPECTION_TENANT_API_SECRET_STAGING=


# ──────────────────────────────────────────────────────────────────────────────
# § 7. Analytics (Veridian Analytics, server-to-server admin)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] URL API Analytics (server-side only, jamais exposé client).
# Si absent : page /dashboard/admin/analytics indique config manquante.
ANALYTICS_API_URL=https://analytics.app.veridian.site

# [OPTIONAL] Admin API key Analytics (server-side only, jamais exposé client).
# Si absent : page /dashboard/admin/analytics indique config manquante.
ANALYTICS_ADMIN_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# § 8. Email (Brevo + fallback SMTP Lark)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED EN PROD] Brevo API key — codes MFA, mails transactionnels critiques
# (signup confirmation, reset password). Si vide → fallback SMTP Lark.
BREVO_API_KEY=

# [COMPOSE-STAGING] Variante _STAGING (sender domain test).
BREVO_API_KEY_STAGING=

# [OPTIONAL] Fallback SMTP Lark si BREVO_API_KEY absent.
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=


# ──────────────────────────────────────────────────────────────────────────────
# § 9. Vault (chiffrement at-rest secrets tenant)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Clé de chiffrement AES-256 hex (32 bytes = 64 hex chars).
# Utilisée pour chiffrer les secrets tenant en DB (Stripe customer IDs,
# tokens OAuth tenant). Rotation = re-chiffrer toute la DB.
# openssl rand -hex 32
VAULT_ENC_KEY=

# [COMPOSE-STAGING] Variante _STAGING. Fallback compose : 32x 'a' (clé bidon).
VAULT_ENC_KEY_STAGING=


# ──────────────────────────────────────────────────────────────────────────────
# § 10. Domain + Site URLs
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] URL publique de l'app (utilisée par Stripe checkout return_url,
# email links, etc.).
NEXT_PUBLIC_SITE_URL=https://app.veridian.site

# [REQUIRED] Alias serveur de SITE_URL. Mêmes valeurs. Distingué par historique
# (composants serveur préfèrent DASHBOARD_SITE_URL, frontend préfère NEXT_PUBLIC_*).
DASHBOARD_SITE_URL=https://app.veridian.site

# [OPTIONAL] Domain sans schéma (ex: app.veridian.site). Utilisé par
# utils/stripe/config.ts pour fabriquer les redirect URLs. Fallback :
# NEXT_PUBLIC_DOMAIN ou NEXT_PUBLIC_SITE_URL.
DOMAIN=app.veridian.site

# [OPTIONAL] Public alias de DOMAIN — exposé client si besoin de connaître
# le host depuis le frontend (ex: génération URLs absolues côté browser).
NEXT_PUBLIC_DOMAIN=

# [OPTIONAL] Auto-injecté par Vercel sur preview deploys (legacy, pas utilisé
# en prod self-host). Hub utilise utils/helpers.ts getURL() qui le lit en
# dernier fallback.
NEXT_PUBLIC_VERCEL_URL=

# [COMPOSE] Host injecté dans les labels Traefik (compose/prod.yml).
# Fallback compose : app.veridian.site. Pas lu par le code.
HUB_HOST=app.veridian.site

# [COMPOSE] Tag image Docker à déployer (compose/base.yml). Posé par la CI
# au push : `latest` pour prod, `staging-<sha7>` pour staging. Pas à
# définir à la main en local.
HUB_IMAGE_TAG=latest

# [COMPOSE] Tag environnement runtime — utilisé par le code Hub pour
# distinguer prod/staging/local (PAS NODE_ENV qui est toujours `production`
# en build Next.js, cf memory feedback_node_env_vs_deploy_env).
DEPLOY_ENV=local


# ──────────────────────────────────────────────────────────────────────────────
# § 11. Analytics frontend (Google Tag Manager)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] GTM container ID exposé au browser. Si vide : pas de tracking GTM.
NEXT_PUBLIC_GTM_ID=

# [COMPOSE-PROD] Alias compose vers NEXT_PUBLIC_GTM_ID (le compose mappe
# GTM_ID_APP_VERIDIAN → NEXT_PUBLIC_GTM_ID côté container).
GTM_ID_APP_VERIDIAN=

# [OPTIONAL] Alias serveur de NEXT_PUBLIC_GTM_ID, pour les composants serveur
# qui injectent le script GTM sans lire la var publique.
DASHBOARD_GTM_ID=


# ──────────────────────────────────────────────────────────────────────────────
# § 12. Notifications opérationnelles (Telegram alertes prod)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Bot Telegram pour alertes critiques (rollback prod, smoke fail).
# Si absent : alertes ignorées (warning dans les logs CI). Lu aussi par
# les workflows .github/workflows/hub-staging.yml + hub-ci.yml.
TELEGRAM_BOT_TOKEN=

# [OPTIONAL] Chat ID Telegram destinataire (group ou DM).
TELEGRAM_CHAT_ID=


# ──────────────────────────────────────────────────────────────────────────────
# § 13. Trial period (legacy override)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Override de la durée de trial en jours. Si absent : 7 jours
# par défaut (cf utils/helpers.ts). À terme : remplacé par le flow trial
# pricing v1.4 (cf docs/PRICING-VERIDIAN.md).
TRIAL_PERIOD_DAYS=7


# ──────────────────────────────────────────────────────────────────────────────
# § 14. Aliases serveur DASHBOARD_* (legacy de l'époque Web-Dashboard)
# ──────────────────────────────────────────────────────────────────────────────
# Ces variables sont des alias historiques que /api/config (et quelques
# composants serveur) lisent en priorité avant les NEXT_PUBLIC_*. Permet à
# certains envs (prod legacy) d'injecter une valeur côté serveur sans
# exposer la même valeur au bundle client. Cf app/api/config/route.ts.
# À retirer quand on aura simplifié /api/config (ticket dette technique).

# [OPTIONAL] Alias serveur de NEXT_PUBLIC_NOTIFUSE_URL.
DASHBOARD_NOTIFUSE_URL=

# [OPTIONAL] Alias serveur de NEXT_PUBLIC_NOTIFUSE_API_URL.
DASHBOARD_NOTIFUSE_API_URL=

# [OPTIONAL] Alias serveur de NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
DASHBOARD_STRIPE_PUBLISHABLE_KEY=

# [OPTIONAL] Alias serveur de NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE.
DASHBOARD_STRIPE_PUBLISHABLE_KEY_LIVE=
