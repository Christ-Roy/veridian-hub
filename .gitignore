.claude/scheduled_tasks.lock

# certificates
certificates
.env*.local
# Exports Stripe temporaires
stripe-config-export-*.json
stripe-products-export.json

# Playwright artifacts (générés par les runs E2E, pas du code source)
/test-results/
/playwright-report/
/playwright/.cache/
e2e-headfull-staging.json
e2e-mega-staging.json
playwright-report-mega/
