#!/usr/bin/env sh
# Standard CI Veridian — pre-push hook
# JAMAIS --no-verify (Constitution CI §3).
#
# Checks bloquants :
#  1. Mapping route↔test (scripts/ci/check-test-mapping.sh)
#  2. Compose sync : base/prod/staging cohérents (scripts/ci/check-compose-sync.sh)
#  3. Migration safety : DROP/RENAME/ALTER NOT NULL/CREATE INDEX bloquants
#     (scripts/ci/check-migration-safety.sh) — uniquement si prisma/migrations modifié
#  4. Risk marker [risk:low] cohérence (scripts/ci/check-risk-marker.sh)
#     — refuse [risk:low] sur des chemins tier 🔴+ (CI-ARCHITECTURE §20.3)

set -e

# ─── 1. Mapping route↔test ──────────────────────────────────────────────
if [ -x scripts/ci/check-test-mapping.sh ]; then
  BASE_REF="${BASE_REF:-origin/$(git rev-parse --abbrev-ref HEAD)}"
  if ! git rev-parse --verify --quiet "$BASE_REF" >/dev/null 2>&1; then
    BASE_REF="origin/main"
  fi
  export BASE_REF
  scripts/ci/check-test-mapping.sh
else
  echo "⚠ scripts/ci/check-test-mapping.sh absent ou non exécutable"
fi

# ─── 2. Compose sync ─────────────────────────────────────────────────────
# Ne tourne que si l'un des fichiers compose a été modifié dans le diff
# vs origin (évite de payer 5s à chaque push qui ne touche pas au compose).
BASE_REF="${BASE_REF:-origin/main}"
COMPOSE_CHANGED=$(git diff --name-only "$BASE_REF"...HEAD 2>/dev/null | grep -E '^(compose/|docker-compose\.yml)' || true)

if [ -n "$COMPOSE_CHANGED" ]; then
  echo "─── Compose modifié, validation cohérence base/prod/staging ───"
  if [ -x scripts/ci/check-compose-sync.sh ]; then
    scripts/ci/check-compose-sync.sh
  else
    echo "⚠ scripts/ci/check-compose-sync.sh absent ou non exécutable"
  fi
fi

# ─── 3. Migration safety ────────────────────────────────────────────────
# Ne tourne que si une migration Prisma est ajoutée/modifiée
MIGRATION_CHANGED=$(git diff --name-only "$BASE_REF"...HEAD 2>/dev/null | grep -E '^prisma/migrations/.+migration\.sql$' || true)

if [ -n "$MIGRATION_CHANGED" ]; then
  echo "─── Migration Prisma modifiée, scan patterns destructifs ───"
  if [ -x scripts/ci/check-migration-safety.sh ]; then
    scripts/ci/check-migration-safety.sh
  else
    echo "⚠ scripts/ci/check-migration-safety.sh absent ou non exécutable"
  fi
fi

# ─── 4. Risk marker [risk:low] cohérence ────────────────────────────────
# Si le commit message porte [risk:low], vérifier qu'aucun fichier touché
# n'est tier 🔴 HAUT ou 💀 CRITIQUE selon CI-ARCHITECTURE §20.3.
if [ -x scripts/ci/check-risk-marker.sh ]; then
  scripts/ci/check-risk-marker.sh
else
  echo "⚠ scripts/ci/check-risk-marker.sh absent ou non exécutable"
fi

# ─── 5. OAUTH_TEST_PROVIDER absent de prod/base ─────────────────────────
# Filet anti-auth-bypass : le mock OAuth provider (lib/auth/mock-oauth-provider.ts)
# active un bypass Google/Microsoft en staging. S'il fuit en prod ou base,
# c'est une auth bypass critique (commande extérieure → session admin).
if [ -x scripts/ci/check-no-test-provider-in-prod.sh ]; then
  scripts/ci/check-no-test-provider-in-prod.sh
else
  echo "⚠ scripts/ci/check-no-test-provider-in-prod.sh absent ou non exécutable"
fi

# ─── 6. ENV sync : code ↔ .env.example ↔ compose/*.yml ──────────────────
# Empêche le drift entre `process.env.X` dans le code, .env.example, et
# les variables référencées dans compose/. Sans ça, un nouveau dev
# déploie sans une var → app crash silencieux ou mode dégradé.
# Skip d'urgence : SKIP_ENV_SYNC=1 git push (à éviter).
if [ -x scripts/ci/check-env-sync.sh ]; then
  scripts/ci/check-env-sync.sh
else
  echo "⚠ scripts/ci/check-env-sync.sh absent ou non exécutable"
fi

exit 0
